# PostgreSQL — en Railway, referencia la variable del plugin Postgres:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remisiones

APP_ENV=development
LOG_FILE=app.log

# Railway inyecta PORT automáticamente; en local puedes dejarlo en 8000
PORT=8000

# SMTP para enviar el manifiesto por email (botón "📧 Email" en Remisiones
# y en Modo operador). Sin esto configurado, el botón responde con error
# "no configurado" pero el resto de la app funciona igual.
# Con Gmail: activa verificación en 2 pasos y generá una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords — no uses tu
# contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicación
SMTP_FROM=tu-correo@gmail.com
